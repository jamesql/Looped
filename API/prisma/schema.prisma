// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  password     String
  avatar       String
  status       String   @default("New to Looped!")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  location     String
  birthday     DateTime
  ownedServers Server[] @relation("ServerOwner")
  servers      Server[] @relation("ServerMembers")

  messages Message[]

  portfolios Portfolio[]

  bannedFrom Server[]

  applications Job[]
  R2File       R2File[]

  roles Role[] @relation("UserRoles")

  friends User[] @relation("FriendsList")
  friendsOf User[] @relation("FriendsList")

  friendRequestsSent User[] @relation("FriendRequests")
  friendRequestsReceived User[] @relation("FriendRequests")

  directChannels DirectChannel[] @relation("DirectChannels") // This will store the direct channels for the user

  directMessages DirectMessage[]
}

model Server {
  id          String   @id @default(cuid())
  name        String
  description String
  iconId      String? @unique
  icon        R2File?  @relation("IconFile", fields: [iconId], references: [id])

  bannerId      String? @unique
  banner        R2File?  @relation("BannerFile", fields: [bannerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String
  website     String   @default("https://looped.it.com")
  members     User[]   @relation("ServerMembers")

  owner User @relation("ServerOwner", fields: [ownerId], references: [id])

  channels Channel[]

  roles Role[]

  invites String[] @default([])

  bannedUsers User[]

  jobListings Job[]
}

model Channel {
  id                 String   @id @default(cuid())
  name               String
  description        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  serverId           String
  type               String
  permissionRequired Int      @default(0)

  server Server @relation(fields: [serverId], references: [id])

  messages Message[]

  roles Role[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  channelId String

  author  User    @relation(fields: [authorId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  file     R2File?
}

model Role {
  id          String   @id @default(cuid())
  name        String
  permissions Int     @default(0) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  serverId    String

  server Server @relation(fields: [serverId], references: [id])

  users User[] @relation("UserRoles")

  channel Channel[]
}

model Portfolio {
  id          String   @id @default(cuid())
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  user User @relation(fields: [userId], references: [id])

  files String[]
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  location    String
  salary      String
  serverId    String
  status      String   @default("Accepting Applications")
  server      Server   @relation(fields: [serverId], references: [id])

  applicants User[]
}

model R2File {
  id             String   @id @default(cuid())
  fileName       String // original name of the uploaded file
  contentType    String // MIME type like 'image/png' or 'application/pdf'
  createdAt      DateTime @default(now())
  fileSize       Int @default(0)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  message  Message? @relation(fields: [messageId], references: [id])
  messageId String? @unique

  iconOf   Server? @relation("IconFile")
  bannerOf Server? @relation("BannerFile")

}

model DirectChannel {
  id String   @id @default(cuid())
  // this is a model to store messages between two friends
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // array of users related
  userIds String[] @default([]) // This will store the user ids of the two users in the direct channel
  users User[] @relation("DirectChannels") // This will store the users in the direct channel, it will be a many to many relation with the User model


  // This will store the messages in the direct channel
  messages DirectMessage[] // This will store the messages in the direct channel, it will be a one to many relation with the Message model

}

model DirectMessage {
  id String   @id @default(cuid())

  directChannelId String 

  authorId String
  author User @relation(fields: [authorId], references: [id])

  content String // The content of the message
  createdAt DateTime @default(now()) // Timestamp for when the message was sent
  updatedAt DateTime @updatedAt // Timestamp for when the message was last updated

  DirectChannel DirectChannel @relation(fields: [directChannelId], references: [id])
}